// tsconfig.json includes only src/main/frontend/** and types.d.ts. Run from command-deck/:
//   pnpm exec tsc --noEmit -p src/test/frontend/tsconfig.json
{
  "extends": "../../../tsconfig.json",
  "include": ["./**/*.ts"]
}
