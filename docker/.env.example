# Copy to docker/.env (gitignored, per-host) before the first `docker compose up`.

COMPOSE_PROJECT_NAME=rupfizupfi

# Password of the PKCS12 keystore. Matches the one startup.sh self-signs; change it together with
# docker/keystore/rupfizupfi.p12 when a real cert is installed.
KEY_STORE_PASSWORD=changeit

# One profile per host: `deck` on the tester, `cms` in the cloud. They collide on port 8043.
COMPOSE_PROFILES=deck

# Tester only: path to a PAT with read:packages, so the deck image build can resolve the published
# dscusb driver plugin. Unset it defaults to the committed empty docker/github-token.empty, which
# builds fine and ships an empty /app/drivers — a startup failure, never a build failure.
#GITHUB_TOKEN_FILE=../.secrets/github-token.txt
