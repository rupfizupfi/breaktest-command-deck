# Copy to docker/.env (gitignored, per-host) before the first `docker compose up`.

COMPOSE_PROJECT_NAME=rupfizupfi

# Password of the PKCS12 keystore. Leave unset for the self-signed default: startup.sh then generates a
# random one and keeps it in docker/keystore/rupfizupfi.p12.password. Set it only when you install a
# real cert at docker/keystore/rupfizupfi.p12 (it must match that file).
#KEY_STORE_PASSWORD=

# One profile per host (both bind port 8043): `cms` in the cloud, `deck` for tests and simulations.
COMPOSE_PROFILES=deck

# Optional: override the deck container's database (defaults to the Compose-local Postgres).
#DECK_DB_URL=jdbc:postgresql://cloud-host:5432/rupfizupfi

# Password of the initial `admin` account, created on first start while no ADMIN exists. No seeded
# accounts ship outside dev; unset, nobody can log in. Remove it once the account exists.
#DECK_ADMIN_PASSWORD=
