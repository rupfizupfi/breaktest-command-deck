# Copy to docker/.env (gitignored, per-host) before the first `docker compose up`.

COMPOSE_PROJECT_NAME=rupfizupfi

# Password of the PKCS12 keystore. Matches the one startup.sh self-signs; change it together with
# docker/keystore/rupfizupfi.p12 when a real cert is installed.
KEY_STORE_PASSWORD=changeit

# One profile per host: `cms` in the cloud, `deck` wherever tests and simulations run. They
# collide on port 8043. The bench itself runs the deck natively, not in a container.
COMPOSE_PROFILES=deck

# Optional: point the deck container at a different database. It defaults to the Compose-local
# Postgres, which is what simulated runs should write to. The native bench uses the cloud Postgres
# and gets its URL from script/run-bench.ps1, not from here.
#DECK_DB_URL=jdbc:postgresql://cloud-host:5432/rupfizupfi
