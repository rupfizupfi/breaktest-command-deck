# Bench settings, read by the bench profile (application-bench.properties) and by run-bench.ps1.
# Copy to .secrets/bench.env (gitignored) and fill in. Plain KEY=VALUE, no quotes. Use / in paths:
# the file is read as Java properties, where a backslash is an escape.
DB_URL=jdbc:postgresql://<host>:<port>/rupfizupfi
DB_PASSWORD=
KEY_STORE_PATH=C:/Users/<you>/keystore/rupfizupfi.p12
KEY_STORE_PASSWORD=
# First start against a database with no ADMIN user only; remove afterwards.
#DECK_ADMIN_PASSWORD=
