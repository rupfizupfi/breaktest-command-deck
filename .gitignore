# Vaadin production frontend bundle (regenerable, ~38 MB)
*/src/main/bundles/
pnpmfile.js
vite.generated.ts

# Driver plugin jars (built in their own repos; usbmodbus is licence-restricted). drivers/README.md
# stays tracked. Anchored so no other directory named drivers/ is ignored.
/drivers/*.jar
# Error screenshots generated by TestBench for failed integration tests
error-screenshots/
webpack.generated.js

frontend/themes/hilla-react-app/theme-editor.css

.fleet/

script/.data

# Snapshot of the bench's ~/breaktester result directory (force CSVs, results export with customer
# contact data). Read only by script/derive-sim-profiles.py; the simulator compiles its numbers in.
/bench-results/
script/app.log

/.secrets
# Local-only deployment secrets: PKCS12 keystore holds an SSL private key
docker/keystore/
docker/.secrets/
# Per-host compose config holding KEY_STORE_PASSWORD; copy docker/.env.example.
docker/.env
# Database dump taken from a live instance
docker/backup.sql

# Runtime settings written by SettingRepository in dev
/settings.json
*/settings.json

*.bak

# Classes extracted from drivers/usbmodbus.jar. That jar's licence forbids
# redistribution, so its extracted contents must not be committed either.
umb/

# supervisord logs and perms dumps from container runs
docker/test/
# IDE run configs with the repo root as working dir generate a Vaadin scaffold here
/package.json
/pnpm-lock.yaml
/pnpm-workspace.yaml
/.npmrc
/src/
/tsconfig.json
/types.d.ts
/vite.config.ts
/vite.generated.ts
/node_modules/
# Generated keystore password (script/run-bench.ps1 -KeyStorePath inside the repo)
*.p12.password
