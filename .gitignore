*/build/
/build/
/target/
*/target/
/.data/
*/.data/
.idea/
.vscode/
.gradle/
.settings
.project
.classpathnpm

*.iml
.DS_Store

node_modules/

# Bytecode from the doc gates (doc/_check-*.py)
__pycache__/
*/src/main/frontend/generated/
# Vaadin production frontend bundle (regenerable, ~38 MB)
*/src/main/bundles/
pnpmfile.js
vite.generated.ts

# Browser drivers for local integration tests (TestBench downloads them to the repo root).
# Anchored deliberately. Unanchored it once swallowed command-deck/src/drivers/ (a vendor-adapter
# source set that no longer exists), whose files then never showed up in git status at all. Keep it
# anchored so a future directory named drivers/ anywhere else does not vanish the same way.
/drivers/
# Error screenshots generated by TestBench for failed integration tests
error-screenshots/
webpack.generated.js

frontend/themes/hilla-react-app/theme-editor.css

.fleet/

# Bench-local driver plugins. Neither belongs in git: dscusb is published to GitHub Packages and
# staged into the image by :command-deck:stageDrivers, usbmodbus is licence-restricted and reaches
# the tester as a host mount. lib/ is only what -PdeckDrivers=local puts on bootRun's classpath.
lib/*.jar
script/.data
scrtip/app.log

/.secrets
# Local-only deployment secrets: PKCS12 keystore holds an SSL private key
docker/keystore/
docker/.secrets/
# Per-host compose config. Carries KEY_STORE_PASSWORD, so it is a credential file however harmless
# the default looks. Copy docker/.env.example, which is tracked and holds the non-secret defaults.
docker/.env
# Host-provided driver plugins mounted into the deck container. The licence-restricted
# usbmodbus.jar lives here and must never be committed or baked into an image. The directory's
# README is tracked so a fresh clone still shows what belongs in it.
docker/drivers-local/*.jar
# Database dump taken from a live instance
docker/backup.sql

# Runtime settings written by SettingRepository in dev
/settings.json
*/settings.json
!.claude/settings.json

*.bak

# Classes extracted from lib/usbmodbus.jar during investigation. That jar's
# committed either.
umb/

# supervisord logs and perms dumps from container runs
docker/test/